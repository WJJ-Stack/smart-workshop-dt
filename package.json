    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "3d-tiles-renderer": "0.5.3",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
