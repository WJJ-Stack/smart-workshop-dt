{
  "name": "smart-workshop-dt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "智能装配车间数字孪生 · Web3D 演示系统 (Three.js + TypeScript)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
